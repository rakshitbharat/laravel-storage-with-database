{
  "name": "rakshitbharat/laravel-storage-with-database",
  "description": "Laravel Storage with Database integration - Store and retrieve text-based data using database storage in Laravel",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "storage",
    "database",
    "filesystem"
  ],
  "authors": [
    {
      "name": "Rakshit Bharat",
      "email": "your-email@example.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Rakshitbharat\\LaravelStorageWithDatabase\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rakshitbharat\\LaravelStorageWithDatabase\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^7.4|^8.0",
    "illuminate/support": "^8.0|^9.0|^10.0",
    "illuminate/database": "^8.0|^9.0|^10.0",
    "illuminate/filesystem": "^8.0|^9.0|^10.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0|^10.0",
    "orchestra/testbench": "^6.0|^7.0|^8.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^1.0",
    "mockery/mockery": "^1.0"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
    "format": "vendor/bin/php-cs-fixer fix",
    "analyse": "vendor/bin/phpstan analyse",
    "check-style": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi",
      "rm -rf vendor composer.lock"
    ],
    "post-autoload-dump": [
      "@clear",
      "@php vendor/bin/testbench package:discover --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Rakshitbharat\\LaravelStorageWithDatabase\\StorageDatabaseServiceProvider"
      ],
      "aliases": {
        "StorageDatabase": "Rakshitbharat\\LaravelStorageWithDatabase\\Facades\\StorageDatabase"
      }
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
